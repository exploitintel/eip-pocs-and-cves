# Repository housekeeping stays at the root. CVE package files must remain
# visible to Git and to Forge's complete-tree publication checks.
/.DS_Store
/py.typed
/*.pyc
/disclosures/
/scripts/

# Vendor source checkouts (can be huge).
/source/

# Metasploit dev environment
/msf-modules/
/msf-init.rc
/msf-lab.sh
/docker-compose.msf.yml
/metasploit/

# Internal docs/reports (local only)
/docs/
/.claude/
/BYPASS_FINDINGS_LOG.md
/INDEX.md

# Local docker helper scripts
/WORKING-DOCKER.md
/check-all-docker.sh

# Docker/lab runtime artifacts
/.env
/.env.control
/reg-page-id.txt
/*.log
/*.pid
/data/
/logs/
/poc-run-logs/
/poc-run-results.md
/runtime-ports.env
/runtime-ports.md
/.docker-compose.verify.yml
/.runtime-port-map.csv
/pipeline-run-report.md
/templates/
/RUN-DOCKER-SINGLE.md

# Internal tooling — not part of the CVE collection itself
/.skills/
