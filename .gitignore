# These repo-housekeeping rules are anchored: an unanchored name matches at any
# depth, so it would also swallow a vendored file of the same name shipped
# inside a CVE package (which then fails the "package destination not
# gitignored" publication gate).
.DS_Store
/py.typed
/*.pyc
/disclosures/
/scripts/

# Vendor source checkouts (can be huge). Anchored like the rules above: an
# unanchored **/source/ also matched `source/` trees that a CVE package ships
# legitimately (CVE-2026-76183 keeps the Tomcat source there), silently
# dropping them from the published tree.
/source/

# Metasploit dev environment
/msf-modules/
/msf-init.rc
/msf-lab.sh
/docker-compose.msf.yml
/metasploit/

# Internal docs/reports (local only)
/docs/
/.claude/
/BYPASS_FINDINGS_LOG.md
/INDEX.md

# Local docker helper scripts
/WORKING-DOCKER.md
/check-all-docker.sh

# Docker/lab runtime artifacts
**/.env
# v4 pipeline packages deliberately ship a reviewed lab-only .env
!CVE-*/.env
**/.env.control
**/reg-page-id.txt
*.log
*.pid
**/data/
/logs/
poc-run-logs/
/poc-run-results.md
/runtime-ports.env
/runtime-ports.md
/.docker-compose.verify.yml
/.runtime-port-map.csv
/pipeline-run-report.md
/templates/
/RUN-DOCKER-SINGLE.md

# Internal tooling — not part of the CVE collection itself
/.skills/
